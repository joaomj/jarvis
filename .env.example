# Jarvis Bot Configuration
# Copy to .env and fill in required values.
#
# For Docker Compose: only TELEGRAM_* and optional Jarvis settings go here.
# LLM provider keys go in .env.opencode (separate file for the OpenCode service).

# Telegram Bot Configuration (REQUIRED)
# Get from @BotFather on Telegram
TELEGRAM_BOT_ID=your_bot_token_here

# Your Telegram User ID (REQUIRED)
# Get from @userinfobot or by messaging your bot and checking logs
TELEGRAM_USER_ID=123456789

# Polling Configuration
TELEGRAM_POLLING_INTERVAL=2
TELEGRAM_POLLING_TIMEOUT=30

# OpenCode Server Configuration
# When running via docker compose, OPENCODE_URL is overridden to http://opencode:4096
# Set OPENCODE_SERVER_PASSWORD to the same value as in .env.opencode
OPENCODE_URL=http://localhost:4096
OPENCODE_SERVER_PASSWORD=secure_password_here

# Database Configuration
DATABASE_PATH=vault/index/jarvis.db
ENABLE_MESSAGE_AUDIT=true
FAVORITE_MODELS_PATH=vault/index/favorite_models.json

# Optional Settings
LOG_LEVEL=INFO
JARVIS_ENV=production

# Knowledge Base (URL saves)
KB_CONTENT_DIR=vault/raw/url-saves
KB_MAX_CHUNKS_PER_QUERY=6
KB_RESCAN_STALE_SECONDS=300
KB_CHUNK_SIZE_CHARS=1800

# Vault root directory
VAULT_ROOT=vault

# X (Twitter) API Configuration (OAuth 2.0)
# Required for bookmark sync. Run 'python scripts/setup_x_oauth.py' to authenticate.
X_CLIENT_ID=""
X_CLIENT_SECRET=""
