# Telegram Bot Configuration (REQUIRED)
# Get from @BotFather on Telegram
TELEGRAM_BOT_ID=your_bot_token_here

# Your Telegram User ID (REQUIRED)
# Get from @userinfobot or by messaging your bot and checking logs
TELEGRAM_USER_ID=123456789

# Webhook Configuration (REQUIRED for webhook mode)
# Use Tailscale Funnel URL: https://your-host.tailnet-name.ts.net/webhook
TELEGRAM_WEBHOOK_URL=https://your-host.tailnet-name.ts.net/webhook

# OpenCode Server Configuration (REQUIRED)
OPENCODE_SERVER_PASSWORD=secure_password_here
OPENCODE_ZEN_API_KEY=your_opencode_zen_api_key_here

# Optional Settings
LOG_LEVEL=INFO
JARVIS_ENV=production
