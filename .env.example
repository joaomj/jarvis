# Alfred Bot Configuration
# Copy to .env and fill in required values.

# Telegram Bot Token (REQUIRED)
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram User ID (REQUIRED)
# Get from @userinfobot
TELEGRAM_USER_ID=123456789

# OpenCode Go API Key (REQUIRED)
# Get from https://opencode.ai/auth after subscribing to Go
OPENCODE_GO_API_KEY=your_opencode_go_key_here

# Model identifier (provider:model-name format)
# Change at runtime via /model command in Telegram
# Full list of available models: see src/models.py
MODEL=opencode-go:deepseek-v4-flash

# Soul identity path
SOUL_PATH=soul/SOUL.md

# Polling Configuration
TELEGRAM_POLLING_INTERVAL=1.0
TELEGRAM_POLLING_TIMEOUT=30

# Database
DATABASE_PATH=vault/index/alfred.db

# Memory limits
MEMORY_MAX_CHARS=5000
USER_PROFILE_MAX_CHARS=2000

# Optional
LOG_LEVEL=INFO
ALFRED_ENV=production
VAULT_ROOT=vault
