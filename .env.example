# Telegram Bot Configuration (REQUIRED)
# Get from @BotFather on Telegram
TELEGRAM_BOT_ID=your_bot_token_here

# Your Telegram User ID (REQUIRED)
# Get from @userinfobot or by messaging your bot and checking logs
TELEGRAM_USER_ID=123456789

# Polling Configuration
TELEGRAM_POLLING_INTERVAL=2
TELEGRAM_POLLING_TIMEOUT=30

# OpenCode Server Configuration (REQUIRED)
OPENCODE_URL=http://localhost:4096
OPENCODE_SERVER_PASSWORD=secure_password_here
OPENCODE_LOG_LEVEL=DEBUG

# Database Configuration
DATABASE_PATH=.jarvis/jarvis.db
ENABLE_MESSAGE_AUDIT=true
FAVORITE_MODELS_PATH=.jarvis/favorite_models.json

# Optional Settings
LOG_LEVEL=INFO
JARVIS_ENV=production

# Knowledge Base (URL saves)
KB_CONTENT_DIR=.jarvis/url-saves
KB_MAX_CHUNKS_PER_QUERY=6
KB_RESCAN_STALE_SECONDS=300
KB_CHUNK_SIZE_CHARS=1800

# Vault root directory
VAULT_ROOT=vault

# QMD (Query Markup Documents) Configuration
# Install: npm install -g @tobilu/qmd
# Setup: qmd collection add ~/projects/jarvis/vault --name jarvis
# Start: qmd mcp --http --daemon
QMD_ENABLED=false
QMD_URL=http://localhost:8181
QMD_TIMEOUT=30.0
QMD_SEARCH_LIMIT=5
QMD_MIN_SCORE=0.2

# X (Twitter) API Configuration
# Get read-only Bearer token from https://developer.twitter.com
# X_BEARER_TOKEN=your_bearer_token_here
