# Jarvis Bot Configuration
# Copy to .env and fill in required values.

# Telegram Bot Token (REQUIRED)
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram User ID (REQUIRED)
# Get from @userinfobot
TELEGRAM_USER_ID=123456789

# Soul identity path
SOUL_PATH=soul/SOUL.md

# Model identifier (PydanticAI format)
MODEL=anthropic:claude-sonnet-4-20250514

# Polling Configuration
TELEGRAM_POLLING_INTERVAL=1.0
TELEGRAM_POLLING_TIMEOUT=30

# Database
DATABASE_PATH=vault/index/jarvis.db

# Memory limits
MEMORY_MAX_CHARS=5000
USER_PROFILE_MAX_CHARS=2000

# Optional
LOG_LEVEL=INFO
JARVIS_ENV=production
VAULT_ROOT=vault
