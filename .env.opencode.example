# OpenCode Service Configuration
# Copy to .env.opencode and fill in required values.
#
# This file is loaded ONLY by the opencode container.
# It contains LLM provider API keys and server password only.
# Telegram/X secrets stay in .env (never loaded by opencode).

# OpenCode Server Password (REQUIRED)
# Must match OPENCODE_SERVER_PASSWORD in .env
OPENCODE_SERVER_PASSWORD=secure_password_here

# OpenCode Log Level
# Use INFO in production (DEBUG leaks API responses into Docker logs)
OPENCODE_LOG_LEVEL=INFO

# LLM Provider API Keys (add the ones you use)
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
